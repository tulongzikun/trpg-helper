{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://trpg-helper.local/schemas/character-snapshot/v1",
 "title":"Published character snapshot v1","type":"object","additionalProperties":false,
 "required":["schemaVersion","characterId","revision","publishedAt","rule","identity","build","features","equipment","spellcasting","derived","provenance"],
 "properties":{
  "schemaVersion":{"const":"character-snapshot/v1"},"characterId":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"publishedAt":{"type":"string","format":"date-time"},
  "rule":{"allOf":[{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/rule"},{"type":"object","properties":{"appliedHouseRuleIds":{}},"required":["appliedHouseRuleIds"]}]},
  "identity":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1},"description":{"type":"string"}}},
  "build":{"type":"object","additionalProperties":false,"required":["classLevels","backgroundId","speciesId","abilities","featIds","chosenOptions","proficiencies","languages"],"properties":{
   "classLevels":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["classId","level"],"properties":{"classId":{"type":"string","minLength":1},"level":{"type":"integer","minimum":1,"maximum":20},"subclassId":{"type":"string","minLength":1}}}},"backgroundId":{"type":"string","minLength":1},"speciesId":{"type":"string","minLength":1},"abilities":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/abilities"},"featIds":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"chosenOptions":{"type":"object","additionalProperties":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"}},"proficiencies":{"type":"object","additionalProperties":false,"required":["saves","skills","weapons","armor","tools"],"properties":{"saves":{"type":"array","uniqueItems":true,"items":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/ability"}},"skills":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"weapons":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"armor":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"tools":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"}}},"languages":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"}
  }},
  "features":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["abilityId","sourceRuleId","sourceType"],"properties":{"abilityId":{"type":"string","minLength":1},"sourceRuleId":{"type":"string","minLength":1},"sourceType":{"enum":["class","subclass","species","background","feat","equipment","other"]},"grantsAtLevel":{"type":"integer","minimum":1},"parameters":{"type":"object","additionalProperties":{"type":["string","number","boolean"]}}}}},
  "equipment":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["itemId","quantity","equipped"],"properties":{"itemId":{"type":"string","minLength":1},"quantity":{"type":"integer","minimum":1},"equipped":{"type":"boolean"},"attuned":{"type":"boolean"},"baseItemId":{"type":"string"}}}},
  "spellcasting":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["sourceId","ability","knownSpellIds","preparedSpellIds"],"properties":{"sourceId":{"type":"string","minLength":1},"ability":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/ability"},"knownSpellIds":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"preparedSpellIds":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"}}}},
  "derived":{"type":"object","additionalProperties":false,"required":["totalLevel","maxHp","baseAc","speedFt","proficiencyBonus","resourceMaxima"],"properties":{"totalLevel":{"type":"integer","minimum":1,"maximum":20},"maxHp":{"type":"integer","minimum":1},"baseAc":{"type":"integer","minimum":0},"speedFt":{"type":"integer","minimum":0},"proficiencyBonus":{"type":"integer","minimum":0},"resourceMaxima":{"type":"object","additionalProperties":{"type":"integer","minimum":0}}}},
  "provenance":{"type":"object","additionalProperties":false,"required":["origin"],"properties":{"origin":{"enum":["internal-builder","manual","external-adapter"]},"sourceName":{"type":"string"},"sourceFingerprint":{"type":"string"}}}
 }
}
