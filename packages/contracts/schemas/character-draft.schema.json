{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://trpg-helper.local/schemas/character-draft/v1",
  "title":"Character draft v1 — may be incomplete, never a battle actor",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","id","status","rule","identity","classLevels","abilities","choices","inventory","knownSpellIds","preparedSpellIds"],
  "properties":{
    "schemaVersion":{"const":"character-draft/v1"},"id":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/id"},"baseRevision":{"type":"integer","minimum":1},"status":{"const":"draft"},
    "rule":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/rule"},
    "identity":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string"},"description":{"type":"string"},"portraitRef":{"type":"string"}}},
    "classLevels":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["classId","level"],"properties":{"classId":{"type":"string","minLength":1},"level":{"type":"integer","minimum":1,"maximum":20},"subclassId":{"type":"string","minLength":1}}}},
    "backgroundId":{"type":"string"},"speciesId":{"type":"string"},
    "abilities":{"type":"object","additionalProperties":false,"properties":{"str":{"type":"integer","minimum":1},"dex":{"type":"integer","minimum":1},"con":{"type":"integer","minimum":1},"int":{"type":"integer","minimum":1},"wis":{"type":"integer","minimum":1},"cha":{"type":"integer","minimum":1}}},
    "choices":{"type":"object","additionalProperties":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"}},
    "inventory":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["itemId","quantity","equipped"],"properties":{"itemId":{"type":"string","minLength":1},"quantity":{"type":"integer","minimum":1},"equipped":{"type":"boolean"},"attuned":{"type":"boolean"}}}},
    "knownSpellIds":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"preparedSpellIds":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"notes":{"type":"string"}
  }
}
