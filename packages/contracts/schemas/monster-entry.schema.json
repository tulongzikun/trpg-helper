{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://trpg-helper.local/schemas/monster-entry/v1",
  "title":"Monster entry and stat blocks v1",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","id","revision","origin","name","source","statBlocks"],
  "properties":{
    "schemaVersion":{"const":"monster-entry/v1"},"id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"origin":{"enum":["builtin","custom"]},"name":{"type":"string","minLength":1},"englishName":{"type":"string"},"aliases":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"familyId":{"type":"string","minLength":1},"habitats":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"treasure":{"type":"string"},"description":{"type":"string"},"lair":{"type":"string"},
    "source":{"type":"object","additionalProperties":false,"required":["name","license"],"properties":{"name":{"type":"string","minLength":1},"license":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"},"attribution":{"type":"string"}}},
    "statBlocks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/statBlock"}}
  },
  "$defs":{
    "statBlock":{"type":"object","additionalProperties":false,"required":["id","name","rule","size","creatureTypes","armorClass","hitPoints","abilities","speedFt","actions"],"properties":{
      "id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"sourceText":{"type":"string"},"rule":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/rule"},"size":{"type":"string","minLength":1},"creatureTypes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"alignment":{"type":"string"},
      "challengeRating":{"type":"string","pattern":"^(0|1/8|1/4|1/2|[1-9][0-9]*)$"},"experiencePoints":{"type":"integer","minimum":0},"proficiencyBonus":{"type":"integer","minimum":0},"initiativeBonus":{"type":"integer"},
      "armorClass":{"type":"integer","minimum":0},"hitPoints":{"type":"object","additionalProperties":false,"required":["average"],"properties":{"average":{"type":"integer","minimum":1},"dice":{"type":"string","minLength":1}}},"abilities":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/abilities"},
      "speedFt":{"type":"object","minProperties":1,"additionalProperties":{"type":"integer","minimum":0}},"savingThrows":{"type":"object","additionalProperties":{"type":"integer"}},"skills":{"type":"object","additionalProperties":{"type":"integer"}},"senses":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"languages":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"damageResistances":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"damageImmunities":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"damageVulnerabilities":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"conditionImmunities":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},"gear":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/strings"},
      "traits":{"$ref":"#/$defs/features"},"actions":{"$ref":"#/$defs/features"},"bonusActions":{"$ref":"#/$defs/features"},"reactions":{"$ref":"#/$defs/features"},"legendaryActions":{"$ref":"#/$defs/features"}
    }},
    "features":{"type":"array","items":{"$ref":"https://trpg-helper.local/schemas/common/v1#/$defs/feature"}}
  }
}
